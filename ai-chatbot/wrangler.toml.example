name = "sadi-ai-business-chatbot"
main = "src/index.js"
compatibility_date = "2026-11-26"

[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = ["/api/*"]

[vars]
GEMINI_MODEL = "gemini-2.5-flash"
BUSINESS_NAME = "Your Business"
BUSINESS_INFO = """
Replace this with approved public business information:
- Business description:
- Products or services:
- Opening hours:
- Location and service area:
- Public contact details:
- Frequently asked questions:
- Policies:
"""
ALLOWED_ORIGINS = "http://localhost:8787,https://your-client-domain.com"
